# Copy to .env (git-ignored) and fill in locally. Never commit .env.
#
# WARNING: pubspec.yaml lists .env as a Flutter asset, so every value in it
# is packaged inside the APK and can be extracted by anyone who has the APK.
# Do not distribute APKs built with a real AZURE_TTS_API_KEY.

# Azure Speech (used by «Слушај» / TtsService).
AZURE_TTS_API_KEY=
AZURE_TTS_REGION=

# Text simplification backend (see backend/README.md).
TEXT_SIMPLIFY_BASE_URL=http://<BACKEND_HOST>:8000
TEXT_SIMPLIFY_API_KEY=
TEXT_SIMPLIFY_USE_MOCK=false
