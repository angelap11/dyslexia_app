# Copy to .env and fill in values. Never commit real secrets.

# Optional: required to download gated / rate-limited HF models
HF_TOKEN=

# Optional: if set, Flutter must send Authorization: Bearer <value>
SIMPLIFY_API_KEY=

# Model id (default matches Flutter contract)
SIMPLIFY_MODEL_ID=LVSTCK/domestic-yak-8B-instruct

# Bind address for uvicorn (see README)
SIMPLIFY_HOST=0.0.0.0
SIMPLIFY_PORT=8000

# Set true ONLY for API validation / CI without GPU weights
# SIMPLIFY_SKIP_MODEL_LOAD=true
